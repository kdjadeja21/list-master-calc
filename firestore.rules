rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Requires the client to be signed in to Firebase Auth (e.g. Google
// sign-in). The temporary local test account never reaches Firestore — its
// data lives entirely in the browser's localStorage — so it isn't covered
// by (or reliant on) these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
